# PostgREST/Realtime access (used by src/supabaseAdmin.js for everything
# except the advisory lock below).
NEXT_PUBLIC_SUPABASE_URL=https://base.sandschi.xyz
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (used only by src/lease.js's advisory locks -
# pg_try_advisory_lock needs a stable backend session across queries, which
# neither PostgREST nor a transaction-mode pooler can guarantee).
# SUPABASE_DB_PORT must be Supavisor's SESSION-mode pooler port, not
# transaction-mode. SUPABASE_DB_USER is Supavisor's tenant-suffixed format:
# postgres.<tenant_id>.
#
# Deployed relay: Supavisor's container over Dokploy's internal
# dokploy-network - never the public hostname, since the connection is
# plaintext. The host ports (5433/6544) are bound to 127.0.0.1 on the
# server, so a relay run locally needs an SSH tunnel instead, e.g.
#   ssh -L 5433:127.0.0.1:5433 <server>   then HOST=127.0.0.1, PORT=5433
SUPABASE_DB_HOST=supabase-pooler
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.<tenant_id>
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres
# Plaintext is an explicit opt-in: only set false for a private network
# path (the dokploy-network hop above, or an SSH tunnel). Default is TLS.
SUPABASE_DB_SSL=false
