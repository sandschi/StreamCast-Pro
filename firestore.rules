rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Master Admin check. request.auth.token.isMasterAdmin is a custom claim,
    // set server-side (src/app/api/set-admin-claim/route.js) after this same
    // account logs in - never client-writable. The hardcoded UID stays as an
    // OR fallback rather than being replaced outright: these rules would
    // otherwise depend on that account having already logged in at least once
    // since the claim was introduced, which isn't guaranteed at the moment
    // this file deploys. Both checks are keyed to the identical UID either way,
    // so this changes nothing about who can become admin, only removes the
    // remaining dependency client-side UI had on the freeze-prone
    // twitchUsername Firestore field (see #19).
    function isMasterAdmin() {
      return request.auth != null &&
        (request.auth.token.isMasterAdmin == true || request.auth.uid == 'WPifULbh4NePmKpojiAnKwv0rWY2');
    }

    // The channel owner, or someone the owner explicitly granted a
    // permissions/{their-own-uid} doc to (an invited mod - see UsersPane.js /
    // useUsersData.js, which only ever writes permissions from the owner's own
    // session). Existence alone is enough here, without reading the role
    // field: a viewer never gets a permissions doc written for them at all
    // (dashboard/page.js treats a missing doc as role 'viewer' by default), so
    // any doc existing at this path is itself proof of an owner-granted invite.
    function isChannelModerator(userId) {
      return request.auth != null && (
        request.auth.uid == userId ||
        exists(/databases/$(database)/documents/users/$(userId)/permissions/$(request.auth.uid))
      );
    }

    // Master Admin Bypass
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }

    // Allow users to read/write their own data
    match /users/{userId} {
      // Split from a blanket "allow read: if true": any signed-in user may still
      // fetch one specific broadcaster's profile by ID (needed so mods/viewers can
      // resolve the channel name to connect chat in someone else's dashboard), but
      // only the real master admin may list/query the whole users collection — the
      // Broadcasters admin panel used to be reachable by anyone who could get the
      // client to believe it was the master admin (e.g. by setting their own
      // twitchUsername to "sandschi"), exposing every broadcaster's profile data.
      allow get: if request.auth != null;
      allow list: if isMasterAdmin();
      // A user may update their own document, but never their own approval status
      // or twitchUsername (once set) — status must only change via the
      // master-admin bypass above (self-approval otherwise), and twitchUsername
      // drives the client-side "is this the master admin" UI check (see
      // AuthContext.js/dashboard/page.js), so letting it change after creation
      // would let a user cosmetically spoof that UI, even though every real
      // permission check (isMasterAdmin() above) is keyed to the Auth UID, not
      // this field.
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'twitchUsername']);
      // The update lock above only protects a doc that already exists — it did
      // nothing to stop a user from bypassing the app UI and calling setDoc
      // directly on their own (not-yet-existing) doc with status: 'approved' as
      // their very first write, self-approving before the update rule ever
      // applies. Require the initial status to be absent or 'waiting'; it can
      // only ever become 'approved'/'denied' afterward via the master-admin
      // bypass above.
      // twitchUsername is still client-settable on create (the real Twitch OAuth
      // response, written client-side — there's no trusted backend path for it
      // yet) so a similar cosmetic spoof is technically still possible here;
      // closing that fully is what the custom-claims migration is for, see
      // https://github.com/sandschi/StreamCast-Pro/issues/19.
      allow create: if request.auth != null && request.auth.uid == userId
        && (!('status' in request.resource.data) || request.resource.data.status == 'waiting');

      match /settings/{document=**} {
        allow read: if true; // Public for overlay
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /private/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /active_message/{document=**} {
        allow read: if true; // Public for overlay
        // Scoped to the owner/invited moderators, same as message_queue below -
        // "Host Mode" previously meant any authenticated user could overwrite
        // what's live on ANY broadcaster's stream just by knowing their UID.
        allow write: if isChannelModerator(userId);
      }

      match /history/{document=**} {
        allow read, write: if isChannelModerator(userId);
      }

      // Pending "show next" queue. Not public: unlike active_message, the
      // overlay never reads or writes this directly (it has no auth, and
      // advancing the queue requires a write) — the dashboard alone owns the
      // full lifecycle: queueing, expiring the active message, and promoting
      // the next queued item. See useChatData.js. Scoped to the owner/invited
      // moderators (isChannelModerator) rather than any authenticated user -
      // "Host Mode" previously meant literally anyone who knew the UID.
      match /message_queue/{document=**} {
        allow read, write: if isChannelModerator(userId);
      }

      match /permissions/{permissionId} {
        allow read: if request.auth != null;
        // Owner or an already-invited mod (ROLE_TABS.mod includes 'users' -
        // UsersPane.js/useUsersData.js let mods manage the user list too, not
        // just the owner). The previous `|| request.auth.uid == permissionId`
        // clause instead let ANY user self-write their own entry into ANY
        // broadcaster's permissions - i.e. self-grant mod access to a channel
        // that never invited them, with no legitimate app flow relying on it.
        // A singer may additionally update only their own `participating`
        // field on a doc that already exists (a mod/broadcaster always creates
        // it first via UsersPane's role buttons) - everything else, role
        // itself included, stays mod/broadcaster only, same reasoning as the
        // users/{userId} status/twitchUsername lock. Split from create/delete
        // rather than one `allow write` so this never has to evaluate
        // resource.data against a not-yet-existing document.
        allow create, delete: if isChannelModerator(userId);
        allow update: if isChannelModerator(userId) || (
          request.auth != null && request.auth.uid == permissionId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participating'])
        );
      }

      // Karaoke song requests (see #27). Read is open to any signed-in user -
      // the Karaoke tab needs to show public requests to every online singer,
      // not just the two people involved. requestedBy/targetSingerUid may
      // each act on the fields that concern them; mods get full control
      // (force-public, decline) via isChannelModerator. Duet invites live on
      // karaoke_staging_queue instead (see below), not on a request doc.
      match /karaoke_requests/{requestId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.requestedBy == request.auth.uid;
        allow update, delete: if isChannelModerator(userId)
          || request.auth.uid == resource.data.requestedBy
          || request.auth.uid == resource.data.targetSingerUid;
      }

      // Rotation-ordered staging list of accepted/self-added songs waiting to
      // be pushed into KaraFun's real queue (see #27) - not KaraFun's own
      // queue, which has no concept of "whose turn is next". The invited
      // co-singer also needs write access to accept/decline their own duet
      // invite - duetInvite is only ever a map or explicitly null, checked
      // that way rather than via .get() chaining (calling .get() on a
      // present-but-null field throws, unlike a genuinely absent key).
      match /karaoke_staging_queue/{entryId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.singerUid == request.auth.uid;
        allow update, delete: if isChannelModerator(userId)
          || request.auth.uid == resource.data.singerUid
          || (resource.data.duetInvite != null && request.auth.uid == resource.data.duetInvite.invitedUid);
      }

      match /online/{onlineId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == onlineId;
      }

      match /suggestions/{suggestionId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }

      match /overlay_triggers/{document=**} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Twitch-username -> uid lookup so karaoke.sandschi.xyz/{username} (see #27)
    // can resolve a human-readable link to the right broadcaster's dashboard
    // without querying/listing the whole users collection. Public read (the
    // route itself is hit by logged-out viewers before they sign in); a user
    // may only ever create the single mapping for their own uid, and it's
    // create-only (no update/delete) so a username can't be reassigned once
    // claimed - matches twitchUsername being locked after creation on the
    // users/{userId} doc itself.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
  }
}
